
digraph flow {
 graph [rankdir=LR,bgcolor="white",pad=.3,nodesep=.35,ranksep=.65,fontname="Arial",label="Check My Meal v2.0 | Backend-first responsibilities",labelloc=t,fontsize=22];
 node [shape=box,style="rounded,filled",fillcolor="#edf5fc",color="#557895",fontname="Arial",fontsize=12,margin=".17,.13"];edge [color="#557895",fontname="Arial",fontsize=10];
 app [label="React Native\nAllowlisted blocks + input capture\nNo clinical formulas",fillcolor="#d9ebf8"];
 ctx [label="Context and authorisation\nSelected profile + free / paid / order\nTyped allowed actions"];
 content [label="Approved preview publisher\nCategory + locale + schema\nComplete version / revocation"];
 attempt [label="Attempt service\n60-minute deadline + revisions\nConfirmation + idempotency"];
 recognition [label="Image recognition service\nCandidates / portions / confidence\nNo authoritative nutrients"];
 food [label="Governed food catalogue\nPreparation + quantity mapping\nVersioned nutrient records"];
 engine [label="General free analysis policy\nSafeguards + deterministic rules\nNot preview-selected"];
 record [label="Immutable completed results\nExact inputs / versions / display\nProtected history"];
 care [label="Existing commercial service\nCurrent plans + order lock\nReadiness-based activation"];
 app -> ctx;ctx -> content;content -> app [label="Typed preview"];
 ctx -> attempt;attempt -> recognition;recognition -> attempt [label="Confirm mappings"];
 attempt -> food;food -> engine;attempt -> engine [label="Confirmed revision"];
 engine -> record;record -> app [label="Display snapshot"];
 ctx -> care;care -> app [label="Allowed navigation"];
}