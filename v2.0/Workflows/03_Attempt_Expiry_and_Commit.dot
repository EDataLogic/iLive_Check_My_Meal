
digraph flow {
 graph [rankdir=TB,bgcolor="white",pad=.3,nodesep=.4,ranksep=.5,fontname="Arial",label="Check My Meal v2.0 | Attempt and expiry",labelloc=t,fontsize=22];
 node [shape=box,style="rounded,filled",fillcolor="#edf5fc",color="#557895",fontname="Arial",fontsize=12,margin=".18,.14"];edge [color="#557895",fontname="Arial",fontsize=10];
 create [label="Server creates attempt while free access is valid\nexpiresAt = createdAt + 60 minutes"];
 draft [label="DRAFT / RECOGNISING / NEEDS_CONFIRMATION\nUser maps and confirms current revision"];
 gate [shape=diamond,label="Ownership + account + deadline\n+ current confirmation + safeguards\n+ non-revoked versions valid?",fillcolor="#fff3d9"];
 calc [label="Calculate and atomically commit\nRecheck deadline and revision at save"];
 saved [label="COMPLETED\nOne immutable result; replay returns same ID",fillcolor="#e2f3ec"];
 no [label="Block commit with typed reason\nFix within deadline or start a NEW eligible attempt",fillcolor="#fce9e8"];
 end [label="CANCELLED / FAILED / EXPIRED\nNo completed-history item; cancel late workers"];
 clean [label="Transient cleanup\nTerminal <=15 min; abandoned <=24 h\nSubject to privacy approval; NOT authorisation"];
 create -> draft;draft -> gate;gate -> calc [label="Yes"];gate -> no [label="No"];calc -> saved [label="Checks still valid"];calc -> no [label="Deadline / revision / safety changed"];
 no -> end;draft -> end [label="Cancel / terminal failure"];saved -> clean;end -> clean;
 note [shape=note,label="Day 7 can end during an attempt.\nIts original deadline never extends.\nActive Day 2 cannot revive a 61-minute draft.",fillcolor="#f4f6f8"];
 create -> note [style=dashed,arrowhead=none];
}