{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Check My Meal draft preview catalogue",
  "type": "object",
  "required": [
    "bundleVersion",
    "schemaVersion",
    "status",
    "productionEnabled",
    "profiles"
  ],
  "properties": {
    "bundleVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "cm-content/2"
    },
    "status": {
      "const": "DRAFT"
    },
    "productionEnabled": {
      "const": false
    },
    "notice": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "keys",
          "labels",
          "mode",
          "clinicalStatus",
          "productionEnabled",
          "analysisRuleEffect"
        ],
        "properties": {
          "id": {
            "enum": [
              "longevity",
              "diabetes",
              "hypertension",
              "ckd",
              "ckdDialysis",
              "recovery"
            ]
          },
          "mode": {
            "const": "CARE_PREVIEW"
          },
          "clinicalStatus": {
            "const": "PENDING_APPROVAL"
          },
          "productionEnabled": {
            "const": false
          },
          "analysisRuleEffect": {
            "const": "NONE"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
